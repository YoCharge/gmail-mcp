# Names only. Never commit real values — see docs/setup.md.
#
# One process serves ONE mailbox. To read a second mailbox, register a second
# server entry with its own GMAIL_ACCOUNT and its own GMAIL_REFRESH_TOKEN.

# The mailbox this process serves. Required — the server refuses to start without it,
# and exits non-zero if the token turns out to belong to a different mailbox.
GMAIL_ACCOUNT=you@example.com

# From your Google Cloud OAuth client (Desktop type).
GMAIL_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=

# Printed by: gmail-mcp-auth you@example.com
GMAIL_REFRESH_TOKEN=

# Required. Which tools this process registers at all — not just which it can use.
# Cumulative tiers only: read / read,draft / read,draft,send.
GMAIL_CAPABILITIES=read,draft,send

# Optional. Fallback directory for download_attachment when the tool call omits dest_dir.
# GMAIL_MCP_DOWNLOAD_DIR=/absolute/path/to/downloads
